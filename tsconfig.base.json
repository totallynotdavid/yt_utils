{
  "compilerOptions": {
    "paths": {
      "@ytutils/core": ["./packages/shared/core/src/index.ts"],
      "@ytutils/metadata": ["./packages/youtube/metadata/src/index.ts"],
      "@ytutils/duration": ["./packages/youtube/duration/src/index.ts"],
      "@ytutils/most-replayed": ["./packages/youtube/most-replayed/src/index.ts"],
      "@ytutils/video-processor": ["./packages/youtube/video-processor/src/index.ts"],
      "@ytutils/video-chunker": ["./packages/youtube/video-chunker/src/index.ts"],
      "@ytutils/most-replayed-maintainer": ["./tools/most-replayed-maintainer/src/types.ts"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node", "vitest/globals"]
  }
}
