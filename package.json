{
  "name": "yt_utils",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "lint": "oxlint packages",
    "fmt": "oxfmt packages",
    "fmt:check": "oxfmt --check packages",
    "typecheck": "bun run --workspaces typecheck",
    "test": "vitest run --passWithNoTests",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "bunup": "^0.16.31",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.64.0",
    "puppeteer": "^24.43.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "packageManager": "bun@1.3.13"
}
