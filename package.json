{
  "name": "yt_most_replayed",
  "version": "0.0.1",
  "description": "Obtain the most replayed segments from a YouTube video",
  "main": "src/index.js",
  "scripts": {
    "typecheck": "tsc -p beta/tsconfig.json --noEmit",
    "lint": "oxlint --config beta/oxlintrc.json beta/src",
    "fmt": "oxfmt beta",
    "fmt:check": "oxfmt --check beta",
    "check": "bun run typecheck && bun run lint && bun run fmt:check"
  },
  "keywords": [
    "YouTube",
    "video",
    "most_replayed"
  ],
  "author": "David Duran <david@caefisica.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "puppeteer": "^24.40.0"
  }
}
