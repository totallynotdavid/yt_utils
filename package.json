{
  "name": "yt_utils",
  "private": true,
  "workspaces": [
    "packages/*/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "bun install --frozen-lockfile",
    "lint": "bun run lint:ts && bun run lint:format && bun run lint:dead",
    "lint:ts": "oxlint --deny-warnings packages apps",
    "lint:format": "oxfmt --check .",
    "lint:dead": "fallow audit",
    "fix": "oxlint --fix packages apps && oxfmt .",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --workspaces typecheck",
    "test": "vitest run",
    "build": "for d in packages/*/* apps/*; do (cd \"$d\" && bun run build) || exit 1; done",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bunup": "^0.16.32",
    "fallow": "^3.37.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
