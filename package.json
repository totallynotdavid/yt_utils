{
  "name": "yt_utils",
  "private": true,
  "workspaces": ["packages/*/*", "apps/*", "tools/*"],
  "scripts": {
    "lint": "oxlint packages apps tools",
    "lint:type-aware": "oxlint packages apps tools",
    "fmt": "oxfmt packages apps tools",
    "fmt:check": "oxfmt --check packages apps tools",
    "typecheck": "bun run --workspaces typecheck",
    "test": "vitest run --passWithNoTests",
    "fallow": "fallow",
    "fallow:check": "fallow audit",
    "check:code": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "check": "bun run check:code && bun run fallow:check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bunup": "^0.16.32",
    "fallow": "^3.6.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.3.14"
}
