{
  "name": "@ytutils/most-replayed",
  "private": true,
  "description": "Extract most replayed segments from YouTube content",
  "author": "David Duran",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
