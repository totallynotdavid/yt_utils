{
  "name": "@ytutils/core",
  "version": "0.1.0",
  "private": false,
  "description": "Core types, errors, parsing, and HTTP contracts for yt_utils packages",
  "keywords": [
    "errors",
    "http",
    "types",
    "utility",
    "youtube"
  ],
  "homepage": "https://github.com/totallynotdavid/yt_utils/tree/master/packages/shared/core#readme",
  "bugs": {
    "url": "https://github.com/totallynotdavid/yt_utils/issues"
  },
  "license": "MIT",
  "author": "David Duran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totallynotdavid/yt_utils.git",
    "directory": "packages/shared/core"
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../../..",
    "build": "bunup",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "engines": {
    "node": ">=22"
  }
}
